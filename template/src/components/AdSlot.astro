---
import { SITE } from '../config/site.mjs';
// Placeholder ad slot. Renders nothing until adsEnabled is true and you drop
// the network's code in. Keeps layout ready without shipping ads prematurely.
const { label = 'Advertisement' } = Astro.props;
---
{SITE.adsEnabled && (
  <aside class="ad-slot" aria-label={label}>
    <!-- Paste ad network code here -->
  </aside>
)}
<style>
  .ad-slot { min-height:90px; margin:1.5rem 0; border:1px dashed var(--line); display:flex; align-items:center; justify-content:center; color:var(--muted); font-size:.8rem; }
</style>
