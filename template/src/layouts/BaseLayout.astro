---
import { SITE } from '../config/site.mjs';

const {
  title,
  description = SITE.tagline,
  type = 'website',
  published,
  updated,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const rootVars = `:root{--accent:${SITE.theme.accent};--accent-dark:${SITE.theme.accentDark};--ink:#1a1a1a;--muted:#5f5f5f;--line:#e6e6e6}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="author" content={SITE.author.name} />
    {published && <meta property="article:published_time" content={published} />}
    {updated && <meta property="article:modified_time" content={updated} />}

    <link rel="sitemap" href="/sitemap-index.xml" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <style set:html={rootVars}></style>
    <style is:global>
      * { box-sizing: border-box; }
      body { margin:0; font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; color:var(--ink); line-height:1.7; }
      a { color: var(--accent-dark); }
      header.site { border-bottom:1px solid var(--line); }
      footer.site { border-top:1px solid var(--line); margin-top:3rem; }
      .wrap { max-width: 760px; margin:0 auto; padding: 1rem 1.25rem; }
      main.wrap { padding-top:2rem; padding-bottom:2rem; }
      nav a { margin-right:1rem; text-decoration:none; font-weight:500; }
      h1 { font-size:2rem; line-height:1.25; }
      .muted { color:var(--muted); font-size:.9rem; }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem;">
        <a href="/" style="font-weight:600;text-decoration:none;color:var(--ink);">{SITE.name}</a>
        <nav>{SITE.nav.map((n) => <a href={n.href}>{n.label}</a>)}</nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap muted">
        <p>{SITE.affiliate.disclosure} <a href="/affiliate-disclosure/">Full disclosure</a>.</p>
        <p>© {new Date().getFullYear()} {SITE.name} · <a href="/about/">About</a> · <a href="/affiliate-disclosure/">Disclosure</a></p>
      </div>
    </footer>
  </body>
</html>
