---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmailSignup from '../../components/EmailSignup.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import { SITE } from '../../config/site.mjs';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.filter((e) => !e.data.draft).map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  author: { '@type': 'Person', name: d.author || SITE.author.name },
  datePublished: d.published,
  ...(d.updated ? { dateModified: d.updated } : {}),
  publisher: { '@type': 'Organization', name: SITE.name },
};
---
<BaseLayout title={d.title} description={d.description} type="article"
  published={d.published} updated={d.updated} jsonLd={jsonLd}>
  <article>
    <h1>{d.title}</h1>
    <p class="muted">By {d.author || SITE.author.name} · {d.published}{d.updated ? ` · updated ${d.updated}` : ''}</p>

    {d.image && <img class="lead-image" src={d.image} alt={d.imageAlt || ''} />}
    {d.imageCredit && <p class="muted" style="margin-top:-1rem;">{d.imageCredit}</p>}

    {d.products && d.products.length > 0 && (
      <div class="picks">
        <h2>Top picks at a glance</h2>
        <ul>
          {d.products.map((p) => (
            <li>
              <strong>{p.name}</strong>{p.blurb ? ` — ${p.blurb}` : ''}
              <div><AffiliateButton url={p.url} product={p.name} label="Check price" /></div>
            </li>
          ))}
        </ul>
      </div>
    )}

    <Content />
  </article>
  <EmailSignup />
  <style>
    .picks { border:1px solid var(--line); border-radius:12px; padding:1rem 1.25rem; margin:1.5rem 0; }
    .picks ul { list-style:none; padding:0; }
    .picks li { padding:.75rem 0; border-bottom:1px solid var(--line); }
    .picks li:last-child { border-bottom:0; }
  </style>
</BaseLayout>
