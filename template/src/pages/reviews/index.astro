---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const items = (await getCollection('reviews')).filter((e) => !e.data.draft)
  .sort((a, b) => String(b.data.published).localeCompare(String(a.data.published)));
---
<BaseLayout title="Reviews" description="Our product reviews.">
  <h1>Reviews</h1>
  <ul class="list">
    {items.map((e) => (
      <li><a href={`/reviews/${e.slug}/`}>{e.data.title}</a><div class="muted">{e.data.description}</div></li>
    ))}
  </ul>
  <style>ul.list{list-style:none;padding:0}ul.list li{padding:.75rem 0;border-bottom:1px solid var(--line)}ul.list a{font-weight:600;text-decoration:none}</style>
</BaseLayout>
