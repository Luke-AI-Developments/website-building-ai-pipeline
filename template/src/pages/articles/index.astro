---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const items = (await getCollection('articles')).filter((e) => !e.data.draft)
  .sort((a, b) => String(b.data.published).localeCompare(String(a.data.published)));
---
<BaseLayout title="Guides & FAQ" description="How-tos, explainers and FAQs.">
  <h1>Guides &amp; FAQ</h1>
  <ul class="card-grid">
    {items.map((e) => (
      <li class="card">
        <a class="card-link" href={`/articles/${e.slug}/`}>
          {e.data.image
            ? <img class="card-thumb" src={e.data.image} alt="" loading="lazy" />
            : <div class="card-thumb-placeholder" />}
          <div class="card-body">
            <span class="card-title">{e.data.title}</span>
            <span class="card-desc">{e.data.description}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
