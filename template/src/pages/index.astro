---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailSignup from '../components/EmailSignup.astro';
import AdSlot from '../components/AdSlot.astro';
import Hero from '../components/Hero.astro';
import { SITE } from '../config/site.mjs';

const live = (c) => c.filter((e) => !e.data.draft)
  .sort((a, b) => String(b.data.published).localeCompare(String(a.data.published)));

const guides = live(await getCollection('guides'));
const reviews = live(await getCollection('reviews'));
const articles = live(await getCollection('articles'));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.tagline,
};
---
<BaseLayout title={null} description={SITE.tagline} jsonLd={jsonLd}>
  <Hero />

  <AdSlot />

  <h2>Buying guides</h2>
  <ul class="card-grid">
    {guides.map((e) => (
      <li class="card">
        <a class="card-link" href={`/guides/${e.slug}/`}>
          {e.data.image
            ? <img class="card-thumb" src={e.data.image} alt="" loading="lazy" />
            : <div class="card-thumb-placeholder" />}
          <div class="card-body">
            <span class="card-title">{e.data.title}</span>
            <span class="card-desc">{e.data.description}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <h2>Reviews</h2>
  <ul class="card-grid">
    {reviews.map((e) => (
      <li class="card">
        <a class="card-link" href={`/reviews/${e.slug}/`}>
          {e.data.image
            ? <img class="card-thumb" src={e.data.image} alt="" loading="lazy" />
            : <div class="card-thumb-placeholder" />}
          <div class="card-body">
            <span class="card-title">{e.data.title}</span>
            <span class="card-desc">{e.data.description}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <h2>Guides &amp; FAQ</h2>
  <ul class="card-grid">
    {articles.map((e) => (
      <li class="card">
        <a class="card-link" href={`/articles/${e.slug}/`}>
          {e.data.image
            ? <img class="card-thumb" src={e.data.image} alt="" loading="lazy" />
            : <div class="card-thumb-placeholder" />}
          <div class="card-body">
            <span class="card-title">{e.data.title}</span>
            <span class="card-desc">{e.data.description}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <EmailSignup />
</BaseLayout>
