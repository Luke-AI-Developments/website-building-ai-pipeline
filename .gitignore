# dependencies / build output
node_modules/
**/node_modules/
dist/
**/dist/
.astro/
**/.astro/

# vercel
.vercel/
**/.vercel/

# secrets / env (never commit)
.env
.env.*
*.key
**/secrets*

# os / editor
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
~$*

# nested template repo is published separately (Luke-AI-Developments/trend-site-template)
# keep its source but ignore its git internals if copied in
template/.git/

# generated sites — each one is its own separate repo (Luke-AI-Developments/<niche-slug>),
# not part of the portfolio repo
sites/*/
