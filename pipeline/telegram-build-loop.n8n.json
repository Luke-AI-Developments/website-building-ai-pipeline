        "jsCode": "const niche = $json.niche;\nfunction sanitizeForCmd(s) {\n  return String(s || '').replace(/[&|<>^\"%\\r\\n]/g, ' ').trim();\n}\nif (!niche) {\n  return [{ json: { ...$json, error: true, errorMessage: 'Send /build <niche>, e.g. /build cast iron cookware care' } }];\n}\nconst safeNiche = sanitizeForCmd(niche);\nconst folder = safeNiche.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-+|-+$)/g, '');\nconst projectDir = 'C:\\\\Users\\\\luket\\\\Claude\\\\Projects\\\\Website passive income';\nconst command = `cd /d \"${projectDir}\" & (type \"pipeline\\\\build-site-agent-prompt.txt\" & echo NICHE: ${safeNiche}) | claude -p --dangerously-skip-permissions`;\nreturn [{ json: { ...$json, error: false, command, folder, safeNiche } }];"
