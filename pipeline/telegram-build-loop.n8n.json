    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = items[0].json;\nconst msg = item.message || {};\nconst text = (msg.text || '').trim();\nconst chatId = msg.chat && msg.chat.id;\n\nlet type = 'unknown';\nlet niche = '';\nlet changesText = '';\n\nif (/^\\/build\\b/i.test(text)) {\n  type = 'build';\n  niche = text.replace(/^\\/build\\s*/i, '').trim();\n} else if (/^\\/ship\\b/i.test(text)) {\n  type = 'ship';\n} else if (text && !text.startsWith('/')) {\n  type = 'change';\n  changesText = text;\n}\n\nreturn [{ json: { type, niche, changesText, chatId, rawText: text } }];"
      },
