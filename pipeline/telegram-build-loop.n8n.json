        "mode": "runOnceForAllItems",
        "jsCode": "const out = $json.stdout || '';\nconst err = $json.stderr || '';\nconst upstream = $('Build: make command').item.json;\nconst chatId = upstream.chatId;\nconst folderMatch = out.match(/PROJECT_FOLDER:\\s*(\\S+)/);\nconst folder = folderMatch ? folderMatch[1] : upstream.folder;\nconst m = out.match(/LIVE_URL:\\s*(\\S+)/);\nconst url = m ? m[1] : null;\nconst staticData = $getWorkflowStaticData('global');\nif (url) {\n  staticData.currentProject = folder;\n  staticData.currentUrl = url;\n}\nconst message = url\n  ? `\\u2705 Preview ready: ${url}\\n\\nReply with a change, or send /ship to go live.`\n  : `\\u26a0\\ufe0f Build finished but no LIVE_URL found. Exit code: ${$json.exitCode}\\n\\nLast bit of output:\\n${(out || err).slice(-800)}`;\nreturn [{ json: { chatId, message } }];"
      },
